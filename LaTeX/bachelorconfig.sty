% Include a build-optimized copy when latexmk has generated one. The third
% argument specifies the maximum image width in pixels; smaller originals are
% never enlarged. A direct LaTeX run falls back to the original image.
\newcommand*{\includeoptimizedimg}[3][]{%
	\IfFileExists{aux/optimized-images/#3px/#2}{%
		\includegraphics[#1]{aux/optimized-images/#3px/#2}%
	}{%
		\includegraphics[#1]{#2}%
	}%
}

