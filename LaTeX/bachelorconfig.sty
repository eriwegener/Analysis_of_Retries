% -----------------------------------------------------------------------------
% Code and terminal output
% -----------------------------------------------------------------------------
\RequirePackage{listings}
\AtBeginDocument{%
	\renewcommand{\lstlistingname}{Codeausschnitt}%
	\renewcommand{\lstlistlistingname}{Codeausschnitte}%
}

\DeclareCaptionType{terminalinputlisting}[Terminaleingabe][Terminaleingaben]
\DeclareCaptionType{terminaloutputlisting}[Terminalausgabe][Terminalausgaben]

\makeatletter
\@addtoreset{terminalinputlisting}{chapter}
\@addtoreset{terminaloutputlisting}{chapter}
\makeatother
\renewcommand{\theterminalinputlisting}{\thechapter.\arabic{terminalinputlisting}}
\renewcommand{\theterminaloutputlisting}{\thechapter.\arabic{terminaloutputlisting}}

\DeclareCaptionStyle{terminalcaption}{
	font=small,
	labelfont=bf,
	labelsep=colon,
	justification=raggedright,
	singlelinecheck=false,
	position=bottom,
	hypcap=false,
	skip=0pt
}
\captionsetup[terminalinputlisting]{style=terminalcaption}
\captionsetup[terminaloutputlisting]{style=terminalcaption}

\newcommand*{\TerminalCaption}[3]{%
	\par\noindent
	\begin{minipage}{\linewidth}
	\captionof{#1}{#2}%
	\label{#3}%
	\end{minipage}%
	\par
}
\newcommand*{\TerminalInputCaption}[2]{%
	\TerminalCaption{terminalinputlisting}{#1}{#2}%
}
\newcommand*{\TerminalOutputCaption}[2]{%
	\TerminalCaption{terminaloutputlisting}{#1}{#2}%
}

\definecolor{TerminalBackground}{HTML}{EEEEEE}
\definecolor{TerminalFrame}{HTML}{2CAADE}
\definecolor{TerminalText}{HTML}{000000}
\definecolor{CodeKeyword}{HTML}{005CC5}
\definecolor{CodeString}{HTML}{22863A}
\definecolor{CodeComment}{HTML}{6A737D}
\newlength{\TerminalFrameSep}
\newlength{\TerminalFrameRule}
\setlength{\TerminalFrameSep}{6pt}
\setlength{\TerminalFrameRule}{0.4pt}

\lstdefinestyle{terminalbase}{
	basicstyle=\scriptsize\ttfamily\color{TerminalText},
	backgroundcolor=\color{TerminalBackground},
	frame=single,
	rulecolor=\color{TerminalFrame},
	framerule=\TerminalFrameRule,
	linewidth=\dimexpr\linewidth-2\TerminalFrameSep-2\TerminalFrameRule\relax,
	xleftmargin=\dimexpr\TerminalFrameSep+\TerminalFrameRule\relax,
	xrightmargin=0pt,
	framexleftmargin=0pt,
	framexrightmargin=0pt,
	framextopmargin=0pt,
	framexbottommargin=0pt,
	framesep=\TerminalFrameSep,
	breaklines=true,
	breakatwhitespace=true,
	columns=fullflexible,
	keepspaces=true,
	mathescape=false,
	escapeinside={(*@}{@*)},
	showstringspaces=false,
	aboveskip=0.75\baselineskip,
	belowskip=0pt,
}

\lstdefinestyle{terminaloutput}{style=terminalbase}
\lstdefinestyle{terminalinput}{style=terminalbase}

\lstdefinestyle{pythoncode}{
	style=terminalbase,
	language=Python,
	numbers=left,
	numberstyle=\tiny\ttfamily\color{gray},
	numbersep=10pt,
	stepnumber=1,
	tabsize=4,
	showspaces=false,
	showtabs=false,
	keywordstyle=\color{CodeKeyword}\bfseries,
	stringstyle=\color{CodeString},
	commentstyle=\color{CodeComment}\itshape,
	sensitive=true,
	captionpos=b,
}

\lstdefinelanguage{json}{
	sensitive=true,
	morestring=[b]",
	morecomment=[l]{//},
	morecomment=[s]{/*}{*/},
	morekeywords={true,false,null},
}

\lstdefinestyle{jsoncode}{
	style=terminalbase,
	language=json,
	numbers=left,
	numberstyle=\tiny\ttfamily\color{gray},
	numbersep=10pt,
	stepnumber=1,
	tabsize=2,
	showspaces=false,
	showtabs=false,
	keywordstyle=\color{CodeKeyword}\bfseries,
	stringstyle=\color{CodeString},
	commentstyle=\color{CodeComment}\itshape,
	sensitive=true,
	captionpos=b,
}

\lstnewenvironment{terminaloutput}[1][]
{\lstset{style=terminaloutput,#1}}
{}

\lstnewenvironment{terminalinput}[1][]
{\lstset{style=terminalinput,#1}}
{}

\lstnewenvironment{pythoncode}[1][]
{\lstset{style=pythoncode,#1}}
{}

\lstnewenvironment{jsoncode}[1][]
{\lstset{style=jsoncode,#1}}
{}

